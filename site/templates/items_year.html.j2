{% extends "base.html.j2" %}
{% from "_macros.html.j2" import source, fact_meta, motion_block, roll_call_block %}
{% block main %}
<h1>Items first seen in {{ year }}</h1>
<p>Each item shows every appearance in the minutes, oldest first. Items are linked by their official number; items without a number are linked only when the title matches exactly, and say so.</p>
<nav aria-label="Items in {{ year }}">
  <ul class="toc">
  {% for it in items %}
    <li><a href="#{{ it.id }}">{% if it.number %}{{ it.number }}{% else %}{{ it.title }}{% endif %}</a></li>
  {% endfor %}
  </ul>
</nav>

{% for it in items %}
<section class="item" id="{{ it.id }}" aria-labelledby="h-{{ it.id }}">
  <h2 id="h-{{ it.id }}">{% if it.number %}{{ it.number }}{% else %}{{ it.title }}{% endif %}</h2>
  {% if it.number %}<p class="item-title">{{ it.title }}</p>{% endif %}
  <p class="muted">{{ it.basis }}</p>
  <ol class="events">
  {% for e in it.events %}
    {% if e.held_back %}
    <li class="event held">
      <p class="event-head"><span class="date">{{ e.date }}</span> <span class="type">{{ e.type_label }}</span></p>
      <p>1 {{ "roll call" if e.type == "roll_call" else "motion" }} is under review and not shown.</p>
    </li>
    {% else %}
    <li class="event fact" data-fact-id="{{ e.id }}">
      <p class="event-head"><span class="date"><a href="{{ root }}{{ e.meeting_href }}">{{ e.date }}</a></span> <span class="type">{{ e.type_label }}</span></p>
      {% if e.label %}<p class="label">{{ e.label }}</p>{% endif %}
      {% if e.roll_call %}{{ roll_call_block(e.roll_call, root) }}{% endif %}
      {% if e.motion %}{{ motion_block(e.motion, root) }}{% endif %}
      <p class="meta">{{ source(e.src) }} <span class="sep" aria-hidden="true">&middot;</span> {{ fact_meta(root, e.id) }}</p>
    </li>
    {% endif %}
  {% endfor %}
  </ol>
</section>
{% else %}
<p>No items are available for {{ year }}.</p>
{% endfor %}
{% endblock %}
