{# How recent each body's records are (sitegen/freshness.py, site-polish/freshness-line): one line per body, every date
   computed from the data at build time and linked to the page of the meeting (or record) that set it, which links its
   source (site-polish/freshness-no-source-link). The same words for every body. The note about minutes running behind
   agendas shows only when a line has both. `collapsed`: a <details> whose summary holds the heading (the landing, whose
   content must fit one phone screen before any lookup: tests/test_address_box.py). Imported `with context` for `root`. #}
{% macro fresh_date(p) -%}
{%- set d -%}{% if p.iso %}<time class="nowrap" datetime="{{ p.iso }}">{{ p.text }}</time>{% else %}<span class="nowrap">{{ p.text }}</span>{% endif %}{%- endset -%}
{%- if p.href and p.href.startswith("https://") -%}<a href="{{ p.href }}" target="_blank" rel="noopener noreferrer">{{ d }}<span class="sr-only"> (opens the source document in a new tab)</span></a>
{%- elif p.href -%}<a href="{{ root }}{{ p.href }}">{{ d }}</a>
{%- else -%}{{ d }}{%- endif -%}
{%- endmacro %}
{% macro fresh_body(lines, note) -%}
  <ul class="fresh-list">
    {% for l in lines %}
    <li>{{ l.body }}: {% for p in l.parts %}{{ p.what }} through {{ fresh_date(p) }}{{ "; " if not loop.last else "." }}{% endfor %}</li>
    {% endfor %}
  </ul>
  {% if note and lines | selectattr("lagged") | list %}<p class="muted fresh-note">{{ note }}</p>{% endif %}
{%- endmacro %}
{% macro freshness(lines, note, heading="How recent the records are", collapsed=false, plain=false) -%}
{% if lines %}
{% if collapsed %}
<details class="freshness" id="freshness">
  {% if plain %}<summary id="fresh-h">{{ heading }}</summary>{% else %}<summary><h2 id="fresh-h" class="fresh-h">{{ heading }}</h2></summary>{% endif %}
  {{ fresh_body(lines, note) }}
</details>
{% else %}
<section class="freshness" id="freshness" aria-labelledby="fresh-h">
  <h2 id="fresh-h" class="fresh-h">{{ heading }}</h2>
  {{ fresh_body(lines, note) }}
</section>
{% endif %}
{% endif %}
{%- endmacro %}
