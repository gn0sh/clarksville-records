{% extends "base.html.j2" %}
{% block main %}
<h1>Corrections</h1>
<p>A factual error is fixed within 2 business days of a report that shows it. The fix follows the source document, never an opinion, and the same policy applies to everyone. Every correction is listed in the log below.</p>
<p>To report an error, use <a href="{{ root }}report.html">Report an error</a>. It says what to include: the page address, the fact id and the source page. How a report is checked is described under <a href="{{ root }}about.html#how-corrections-work">How corrections work</a> on About.</p>
<section aria-labelledby="log-h">
  <h2 id="log-h">Public log of corrections</h2>
  {% if log %}
  <div class="table-scroll" tabindex="0" role="region" aria-label="Corrections log">
  <table class="aliases">
    <thead><tr><th scope="col">Date</th><th scope="col">Page</th><th scope="col">Was</th><th scope="col">Now</th><th scope="col">Source</th></tr></thead>
    <tbody>
    {% for r in log %}
      <tr><th scope="row">{{ r.date | day_words }}</th><td>{{ r.page }}</td><td>{{ r.was }}</td><td>{{ r.now }}</td>
      <td><a data-ext="corrections" href="{{ r.source_url }}" target="_blank" rel="noopener noreferrer">Source<span class="sr-only"> (opens in a new tab)</span></a></td></tr>
    {% endfor %}
    </tbody>
  </table>
  </div>
  {% else %}
  <p>No corrections yet.</p>
  {% endif %}
</section>
{% endblock %}
