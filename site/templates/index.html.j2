{% extends "base.html.j2" %}
{% from "_feed_links.html.j2" import feed_links %}
{% from "_hub.html.j2" import overview %}
{% from "_freshness.html.j2" import freshness as fresh with context %}
{% block head %}<script src="{{ root }}static/js-flag.js"></script>{{ feed_links(home_feeds | default([]), root) }}{% endblock %}
{% block sky %}
<div class="sky-hero" id="sky-hero" data-tz="{{ site.cfg.site_timezone }}" hidden>
  <p class="sky-day"><span class="sky-dow"><span id="sky-weekday"></span><span class="sky-in"> in {{ site.cfg.today_place }}</span></span> <a class="sky-link" href="today.html"><time class="sky-date" id="sky-date"></time><span class="sky-go" aria-hidden="true">&rsaquo;</span><span class="sr-only">: meetings day by day</span></a></p>
</div>
{% endblock %}
{% block main %}
{# Landing v2 (docs/design/front-page-v2.md, 2026-11-11): a welcome, the address box in its own card, four "Start
   here" doors, the meetings coming up and the most recent ones (a selection of today.html's cards, built with the
   page), one records search, then the three details about these records. The county map was removed (CEO,
   2026-11-10); its traced lines stay as data in the address box's settings, because the lookup places the Census
   point against them (docs/research/map-removal-2026-11-10.md). Everything works without script except the address
   form, which needs it; then the card offers the list and the official lookup instead. #}
{% set dl = site.cfg.district_layer %}{% set wl = site.cfg.ward_layer %}{% set wards_live = address and address.get('wards') %}{# shapes the lookup checks #}
<div class="landing">
  {# static/switch.js puts its "Showing ... only" line and its "Show all" button here, first on the page, when a body
     other than All is chosen (the choice is remembered on the device): on the first screen at every width, next to
     the switch it describes, not down by the meetings it filters (owner, 2026-11-13: the choice was easy to miss). #}
  <div data-body-line></div>
  <section class="welcome" aria-labelledby="welcome-h">
    <h1 id="welcome-h" class="welcome-h">{{ site.cfg.welcome_h1 }}</h1>
    {# Phone (mobile-front-lite): one short sentence in place of the lede, so the address box is on the first screen.
       .phone-off / .phone-only are display:none on the other side of 600px, so only one of the two is ever read. #}
    {% set lede_phone = site.cfg.get("welcome_lede_phone") %}
    <p class="lede">{% if lede_phone %}<span class="phone-off">{{ welcome_lede }}</span><span class="phone-only">{{ lede_phone }}</span>{% else %}{{ welcome_lede }}{% endif %}</p>
    {# the short form; the header tag is beside the name and the full notice is in this page's footer, as on every page #}
    <p class="unofficial-intro" id="unofficial-short">{{ site.unofficial.email_line }} <a href="{{ root }}about.html#unofficial">About this site</a></p>
  </section>

  {# Address search first (CEO decision, Nov 9): most first-time visitors do not know their ward or district. The
     form stays hidden until static/address.js shows it (it needs the script; without it a submit would only put the
     address in this site's own URL). The address is not stored; see the privacy line. The lookup runs in a sandboxed
     iframe that address.js makes per submit (opaque origin, removed after). The district and ward list below is the
     second way in. #}
  <section class="find" aria-labelledby="find-h">
    <h2 id="find-h">Find who represents you</h2>
    <section id="your-seats" class="your-seats" aria-labelledby="your-seats-h" hidden>
      <h3 id="your-seats-h">Your seats</h3>
      <ul class="your-seats-list"></ul>
      <button type="button" class="your-seats-forget" id="seats-forget" aria-label="Forget my saved seats">Forget</button>
      <p class="your-seats-note">Saved only in this browser, on this device. {% if site.morning_note %}{{ site.morning_note.seats_sent }} No cookies are used.{% else %}Nothing is sent anywhere and no cookies are used.{% endif %}</p>
    </section>
    <p class="sr-only" id="seats-status" role="status" aria-live="polite"></p>
{% if address %}
    <form class="addr-form" id="addr-form" hidden>
      <label for="addr-q">Enter your street address<span class="phone-off"> to see your {% if wards_live %}city ward and county district{% else %}county district{% endif %}</span>.</label>
      <div class="search-row">
        <input id="addr-q" type="text" autocomplete="street-address" maxlength="200" placeholder="Street address, city" aria-describedby="addr-privacy">
        <button type="submit">Find</button>
      </div>
      {# Phone: the same two facts (sent to the geocoder, not stored here) and the privacy link, in fewer words. #}
      <p class="addr-privacy" id="addr-privacy"><span class="phone-off">Your address is sent</span><span class="phone-only">Sent</span> to {{ site.cfg.geocoder_label }}<span class="phone-off"> to find where it is</span>. This site doesn't store it. <a data-ext="geocoder" href="{{ site.cfg.geocoder_privacy_url }}" rel="noopener">{{ site.cfg.geocoder_short }}'s privacy policy</a><span class="phone-off"> applies.</span>{% if site.cfg.district_lookup_url %} <span class="addr-alt">Or look it up on <a data-ext="lookup" href="{{ site.cfg.district_lookup_url }}" rel="noopener">{{ site.cfg.district_lookup_label }}</a>.</span>{% endif %}</p>
      <p class="addr-result" id="addr-result" role="status" aria-live="polite"></p>
    </form>
    <script type="application/json" id="addr-config">{{ address|tojson }}</script>
{% endif %}
    <p class="find-alt"><a href="#wards-districts"><span class="addr-on">Or pick</span><span class="addr-off">Pick</span> from the list of {% if site.councils %}{{ site.cfg.ward_count }} wards and {{ district_count }} districts{% else %}{{ district_count }} districts{% endif %}</a></p>
    {% if site.cfg.district_lookup_url %}
    <p class="district-lookup">Not sure of your district? <a data-ext="lookup" href="{{ site.cfg.district_lookup_url }}" rel="noopener">Look it up on {{ site.cfg.district_lookup_label }}</a>.</p>
    {% endif %}
  </section>

  {% if doors %}
  <h2 class="sec-h" id="doors-h">Start here</h2>
  <ul class="doors doors-{{ doors | length }}" aria-labelledby="doors-h">
    {% for d in doors %}
    <li class="door door-{{ d.key }}">
      <h3>{{ d.title }}</h3>
      <p>{{ d.text }}</p>
      <ul>
        {% for lk in d.links %}
        <li><a href="{{ root }}{{ lk.href }}"><span>{{ lk.label }}</span><span class="go" aria-hidden="true">&rsaquo;</span></a></li>
        {% endfor %}
      </ul>
    </li>
    {% endfor %}
  </ul>
  {% endif %}

  {{ overview(site.switch | default(none), root) }}

  {# A selection of today.html's own cards (sitegen/days.py landing_meetings), fixed when the site is built: it says
     so, and static/landing.js moves a row whose day has passed when the page is read later. Each row links its day
     on today.html, whose card links the source. Only the body, the meeting kind and the date are shown here. #}
  {% set m = meetings %}
  <section class="meetings" id="meetings" aria-labelledby="meet-h" data-built="{{ m.built }}" data-tz="{{ site.cfg.site_timezone }}" data-n="{{ m.n }}">
    <h2 class="sec-h" id="meet-h">Meetings</h2>
    <p class="sec-sub">As of <time datetime="{{ m.built }}">{{ m.built_text }}</time>.<span class="phone-off"> Tap a meeting for its agenda, minutes and votes.</span></p>
    <p class="sec-sub meet-stale" id="meet-stale" hidden>This list was built on {{ m.built_text }}; later meetings appear when it is built again.</p>
    {% macro meet_rows(rows, hidden=false) %}
      {% for r in rows %}
      <li data-iso="{{ r.iso }}" data-body="{{ r.bkey }}"{% if hidden %} hidden{% endif %}><a class="meet-row" href="{{ root }}{{ r.href }}">
        <span class="meet-date" aria-hidden="true"><span class="dow">{{ r.dow }}</span><b>{{ r.n }}</b><span class="mon">{{ r.month }}</span></span>
        <span class="meet-what"><span class="sr-only">{{ r.text }}: </span><span class="meet-body"><i class="dot dot-{{ r.dot }}" aria-hidden="true"></i>{{ r.body }}</span>{% if r.title %}<span class="meet-kind">{{ r.title }}</span>{% endif %}</span>
        {% if r.chip %}<span class="chip chip-status" data-chip="{{ r.chip }}">{{ r.chip }}</span>{% endif %}</a></li>
      {% endfor %}
    {% endmacro %}
    {% if m.upcoming or m.recent %}{# a spare row is only ever after a shown one #}
    <div class="meet-cols">
      <div class="meet-col" data-body-group>
        <h3 id="up-h">Coming up</h3>
        <ul class="meet-list" id="meet-up" aria-labelledby="up-h"{% if not m.upcoming %} hidden{% endif %}>{{ meet_rows(m.upcoming) }}{{ meet_rows(m.spare, hidden=true) }}</ul>
        <p class="meet-empty" id="meet-up-empty"{% if m.upcoming %} hidden{% endif %}>No upcoming meetings are in these records yet. A meeting appears here once its body posts an agenda or lists a date.</p>
        <p class="meet-empty bs-none">No meetings of the body you chose are listed here.</p>
      </div>
      <div class="meet-col" data-body-group>
        <h3 id="past-h">Most recent</h3>
        <ul class="meet-list" id="meet-recent" aria-labelledby="past-h"{% if not m.recent %} hidden{% endif %}>{{ meet_rows(m.recent) }}</ul>
        <p class="meet-empty" id="meet-recent-empty"{% if m.recent %} hidden{% endif %}>No meetings in the last four weeks are in these records.</p>
        <p class="meet-empty bs-none">No meetings of the body you chose are listed here.</p>
      </div>
    </div>
    <p class="meet-foot"><span class="phone-off">Only meetings in these records are listed: a meeting appears once its body posts an agenda or lists a date. Each body's own calendar is the official schedule. </span><a href="{{ root }}today.html#day-bodies-h">What is and is not collected</a></p>
    {% else %}
    <p class="meet-empty">No meetings from the last four weeks or the next four are in these records.</p>
    {% endif %}
    <p class="meet-more"><a href="{{ root }}today.html">All meetings, day by day <span aria-hidden="true">&rsaquo;</span></a></p>
  </section>

  <h2 class="sec-h" id="search-h">Looking for something specific?</h2>
  <form class="landing-search" action="search.html" method="get" role="search" aria-labelledby="search-h">
    <label for="landing-q" class="sec-sub">Search by street, name, topic or item number.</label>
    <div class="search-row">
      <input id="landing-q" name="q" type="search" placeholder="Search: item, number, name or street">
      <button type="submit">Search</button>
    </div>
  </form>

  <div class="more landing-list">
    {{ fresh(freshness | default([]), freshness_note | default(""), collapsed=true, plain=true) }}
    <details class="district-list" id="wards-districts"{% if not address %} open{% endif %}>
      <summary>{% if site.councils %}All {{ site.cfg.ward_count }} wards and {{ district_count }} districts, as a list{% else %}All {{ district_count }} districts, by number{% endif %}</summary>
      {% if basis %}<p class="basis muted">{{ basis }}.</p>{% endif %}
      <nav aria-label="{{ dl.label }}">
        <ol class="districts">
          {% for r in rows %}
          <li data-district="{{ r.number }}"><a href="{{ r.href }}"><span class="d-label">{{ r.label }}</span></a>{% if r.holder %} <span class="d-holder">{% if r.holder_href %}<a href="{{ r.holder_href }}">{{ r.holder }}</a>{% else %}{{ r.holder }}{% endif %}</span>{% endif %}</li>
          {% endfor %}
        </ol>
      </nav>
      <h2 class="list-h">{{ wl.label }}</h2>
      {% for c in site.councils %}
      {% if c.basis %}<p class="basis muted">{{ c.basis }}.</p>{% endif %}
      <nav aria-label="{{ c.label }} seats">
        <ol class="districts">
          {% for s in c.seats %}
          <li data-seat="{{ s.seat }}"><a href="{{ root }}{{ s.href }}"><span class="d-label">{{ s.label }}</span></a>{% if s.holder %} <span class="d-holder"><a href="{{ root }}{{ s.holder.href }}">{{ s.holder.name }}</a></span>{% endif %}</li>
          {% endfor %}
        </ol>
      </nav>
      {% else %}
      <p>{{ wl.label }} pages are coming.</p>
      {% endfor %}
    </details>
    {% if address %}{% set src = lookup_sources %}
    <details class="lookup-about">
      <summary>How the address lookup works, and what is saved</summary>
      {% if src %}<p class="lookup-caption">The {{ site.cfg.geocoder_short }} point is checked against the current district lines{% if wards_live %} and the city ward lines{% endif %}, as traced for this site. District lines: <a data-ext="map" href="{{ src.districts.url }}" target="_blank" rel="noopener noreferrer">{{ src.districts.title }}<span class="sr-only"> (opens in a new tab)</span></a>, fetched {{ src.districts.fetched }}.{% if src.swap %} {{ src.swap.before }}<a data-ext="county" href="{{ src.swap.url }}" target="_blank" rel="noopener noreferrer">{{ src.swap.link }}<span class="sr-only"> (opens in a new tab)</span></a>{{ src.swap.after }}{% endif %}{% if src.wards %} Ward lines: <a data-ext="map" href="{{ src.wards.url }}" target="_blank" rel="noopener noreferrer">{{ src.wards.title }}<span class="sr-only"> (opens in a new tab)</span></a>, fetched {{ src.wards.fetched }}.{% endif %} Old district lines: {% if site.cfg.old_lines_map_url %}<a data-ext="county" href="{{ site.cfg.old_lines_map_url }}" target="_blank" rel="noopener noreferrer">map (PDF)<span class="sr-only"> (opens in a new tab)</span></a>{% else %}the map has not been found yet; <a data-ext="county" href="{{ site.cfg.redistricting_page }}" target="_blank" rel="noopener noreferrer">county {{ site.cfg.redistricting_label }} page<span class="sr-only"> (opens in a new tab)</span></a>{% endif %}.</p>{% endif %}
      <p class="lookup-caption addr-seats-note">After a lookup, only the {% if wards_live %}district and ward numbers are{% else %}district number is{% endif %} kept, in this browser on this device, to show "Your seats" next time, with a Forget button. No cookies.{% if site.morning_note %} {{ site.morning_note.seats_sent }}{% endif %}{% if not wards_live %} City ward lookup is coming; the wards are listed above.{% endif %}</p>
    </details>
    {% endif %}
  </div>
</div>
{% endblock %}
{% block scripts %}<script src="{{ root }}static/seats.js" defer></script>{% if address %}
<script src="{{ root }}static/georef.js" defer></script>
<script src="{{ root }}static/address.js" defer></script>{% endif %}
<script src="{{ root }}static/landing.js" defer></script>{% endblock %}
