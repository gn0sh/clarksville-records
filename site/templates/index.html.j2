{% extends "base.html.j2" %}
{% from "_map.html.j2" import county_map %}
{% block main %}
{# Landing (design 3): purpose, search, layer switch, map, the district list (collapsed: the map is the primary
   picker) and a small "About this map" disclosure. The whole landing fits one screen on a phone and a desktop. #}
{% set dl = site.cfg.district_layer %}{% set wl = site.cfg.ward_layer %}
<div class="landing">
  <h1 class="purpose">{{ site.cfg.purpose }}</h1>
  <p class="muted purpose-sub"><span class="nowrap">{{ coverage.from }}</span> to <span class="nowrap">{{ coverage.to }}</span>. {% for c in site.councils %}<a href="{{ root }}{{ c.href }}">{{ c.label }}</a>: <span class="nowrap">{{ c.from }} to {{ c.to }}</span>.{% if not loop.last %} {% endif %}{% else %}{{ site.cfg.city_coming }}{% endfor %}</p>

  {# Address search first (CEO decision, Nov 9): most first-time visitors do not know their ward or district. The
     form stays hidden until static/address.js shows it (it needs the script; without it a submit would only put the
     address in this site's own URL). The address is not stored; see the privacy line. The lookup runs in a sandboxed
     iframe that address.js makes per submit (opaque origin, removed after). The map below is the second way in. #}
  <section id="your-seats" class="your-seats" aria-labelledby="your-seats-h" hidden>
    <h2 id="your-seats-h">Your seats</h2>
    <ul class="your-seats-list"></ul>
    <button type="button" class="your-seats-forget" id="seats-forget" aria-label="Forget my saved seats">Forget</button>
    <p class="your-seats-note">Saved only in this browser, on this device. Nothing is sent anywhere and no cookies are used.</p>
  </section>
  <p class="sr-only" id="seats-status" role="status" aria-live="polite"></p>
{% if address %}
  <form class="addr-form" id="addr-form" hidden>
    <div class="search-row">
      <label for="addr-q">{% if map and map.wards %}Find your ward and county district by address{% else %}Find your county district by address{% endif %}</label>
      <input id="addr-q" type="text" autocomplete="street-address" maxlength="200" placeholder="Street address, city" aria-describedby="addr-privacy">
      <button type="submit">Find</button>
    </div>
    <p class="addr-privacy" id="addr-privacy">Your address is sent to {{ site.cfg.geocoder_label }} to find it on the map. This site doesn't store it. <a data-ext="geocoder" href="{{ site.cfg.geocoder_privacy_url }}" rel="noopener">{{ site.cfg.geocoder_short }}'s privacy policy</a> applies.{% if site.cfg.district_lookup_url %} <span class="addr-alt">Or look it up on <a data-ext="lookup" href="{{ site.cfg.district_lookup_url }}" rel="noopener">{{ site.cfg.district_lookup_label }}</a>.</span>{% endif %}</p>
    <p class="addr-privacy addr-seats-note">After a lookup or a click on the map, only the district number is kept, in this browser on this device, to show "Your seats" next time, with a Forget button. No cookies.{% if not (map and map.wards) %} City ward lookup is coming; the wards are listed below the map.{% endif %}</p>
    <p class="addr-result" id="addr-result" role="status" aria-live="polite"></p>
  </form>
  <script type="application/json" id="addr-config">{{ address|tojson }}</script>
{% endif %}

  <form class="landing-search" action="search.html" method="get" role="search">
    <label for="landing-q" class="sr-only">Search records</label>
    <div class="search-row">
      <input id="landing-q" name="q" type="search" placeholder="Search: item, number, name or street">
      <button type="submit">Search</button>
    </div>
  </form>

  <div class="landing-grid">
    <div class="landing-map">
      <fieldset class="layer-switch">
        <legend>Map shows</legend>
        <label><input type="radio" name="layer" id="show-districts" value="districts" checked> <span class="wide-only">{{ dl.label }}</span><span class="narrow-only" aria-hidden="true">{{ dl.short }}</span></label>
        <label><input type="radio" name="layer" id="show-wards" value="wards"> <span class="wide-only">{{ wl.label }}{% if wl.coming %} (coming){% endif %}</span><span class="narrow-only" aria-hidden="true">{{ wl.short }}{% if wl.coming %} (coming){% endif %}</span></label>
      </fieldset>
      {% if site.councils %}
      <p class="wards-note note">A map of the {{ site.cfg.city_name }} wards is not available yet. {% for c in site.councils %}<a href="{{ root }}{{ c.href }}#seats-h">{{ c.label }} seats</a>.{% endfor %}</p>
      {% else %}
      <p class="wards-note note">{{ site.cfg.city_name }} wards are coming. The city's records have not been collected yet.</p>
      {% endif %}
      {% if map %}
      <p class="sr-only">Map of {{ site.cfg.county_name }}'s {{ district_count }} commission districts. The same districts are listed after the map.</p>
      {{ county_map(map, root, site.cfg, links=true) }}
      {% else %}
      <div class="map-placeholder" role="note"><p>The map is not available yet. Districts are listed by number.</p></div>
      {% endif %}
      {% if site.cfg.district_lookup_url %}
      <p class="district-lookup note">Not sure of your district? <a data-ext="lookup" href="{{ site.cfg.district_lookup_url }}" rel="noopener">Look it up on {{ site.cfg.district_lookup_label }}</a>.</p>
      {% endif %}
    </div>

    <div class="landing-list">
      <details class="district-list"{% if not map %} open{% endif %}>
        <summary><span class="wide-only">{% if site.councils %}All {{ site.cfg.ward_count }} wards and {{ district_count }} districts, as a list{% else %}All {{ district_count }} districts, by number{% endif %}</span><span class="narrow-only" aria-hidden="true">{% if site.councils %}Wards and districts, list{% else %}All {{ district_count }} districts{% endif %}</span></summary>
        {% if basis %}<p class="basis muted">{{ basis }}.</p>{% endif %}
        <nav aria-label="{{ dl.label }}">
          <ol class="districts">
            {% for r in rows %}
            <li data-district="{{ r.number }}"><a href="{{ r.href }}"><span class="d-label">{{ r.label }}</span></a>{% if r.holder %} <span class="d-holder">{% if r.holder_href %}<a href="{{ r.holder_href }}">{{ r.holder }}</a>{% else %}{{ r.holder }}{% endif %}</span>{% endif %}</li>
            {% endfor %}
          </ol>
        </nav>
        <h2 class="list-h">{{ wl.label }}</h2>
        {% for c in site.councils %}
        {% if c.basis %}<p class="basis muted">{{ c.basis }}.</p>{% endif %}
        <nav aria-label="{{ c.label }} seats">
          <ol class="districts">
            {% for s in c.seats %}
            <li data-seat="{{ s.seat }}"><a href="{{ root }}{{ s.href }}"><span class="d-label">{{ s.label }}</span></a>{% if s.holder %} <span class="d-holder"><a href="{{ root }}{{ s.holder.href }}">{{ s.holder.name }}</a></span>{% endif %}</li>
            {% endfor %}
          </ol>
        </nav>
        {% else %}
        <p>{{ wl.label }} pages are coming.</p>
        {% endfor %}
      </details>
      {% if map %}
      <details class="map-about">
        <summary>About this map</summary>
        <p class="map-caption">Current district lines. Boundaries: <a data-ext="map" href="{{ map.source_url }}" target="_blank" rel="noopener noreferrer">{{ map.source_title }}<span class="sr-only"> (opens in a new tab)</span></a>, fetched {{ map.fetched }}.{% if map.swap %} {{ map.swap.before }}<a data-ext="county" href="{{ map.swap.url }}" target="_blank" rel="noopener noreferrer">{{ map.swap.link }}<span class="sr-only"> (opens in a new tab)</span></a>{{ map.swap.after }}{% endif %} Old district lines: {% if site.cfg.old_lines_map_url %}<a data-ext="county" href="{{ site.cfg.old_lines_map_url }}" target="_blank" rel="noopener noreferrer">map (PDF)<span class="sr-only"> (opens in a new tab)</span></a>{% else %}the map has not been found yet; <a data-ext="county" href="{{ site.cfg.redistricting_page }}" target="_blank" rel="noopener noreferrer">county {{ site.cfg.redistricting_label }} page<span class="sr-only"> (opens in a new tab)</span></a>{% endif %}.</p>
      </details>
      {% endif %}
    </div>
  </div>
</div>
{% endblock %}
{% block scripts %}{% if map %}<script src="{{ root }}static/map.js" defer></script>{% endif %}{% if map or address %}
<script src="{{ root }}static/seats.js" defer></script>{% endif %}{% if address %}
<script src="{{ root }}static/georef.js" defer></script>
<script src="{{ root }}static/address.js" defer></script>{% endif %}{% endblock %}
