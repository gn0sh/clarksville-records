{% extends "items_year.html.j2" %}
{# A council's items first seen in one year (council.py items_year): the county's item page, with the council's name
   and its years. #}
{% block items_head %}
<p class="kicker-line"><a href="{{ root }}{{ council_href }}">{{ council }}</a></p>
<h1>Items first seen in {{ year }}</h1>
<p class="lede">{{ body }}. Each item shows every appearance in the minutes, oldest first. Items are linked by their official number; items without a number are linked only when the title matches exactly, and say so.</p>
<nav aria-label="Items by year" class="year-nav">
  <ul class="inline-list">
    {% for y in years %}<li><a href="{{ y }}.html"{% if y == year %} aria-current="page"{% endif %}>{{ y }}</a></li>{% endfor %}
  </ul>
</nav>
{% endblock %}
