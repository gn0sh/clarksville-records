<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<title>{{ site.site_name }} | {{ page_name }}</title>
<link rel="stylesheet" href="{{ root }}static/style.css">
{% block head %}{% endblock %}
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
{% if site.fixture %}
<div class="banner" role="note"><strong>FIXTURE.</strong> This page shows made-up test data, not real records.</div>
{% endif %}
<header class="site-header">
  <div class="masthead">
    <div class="brand">
      <p class="site-name"><a href="{{ root }}index.html">{{ site.site_name }}</a></p>
      <p class="kicker">{{ site.coverage.body }} minutes, <span class="nowrap">{{ site.coverage.from }}</span> to <span class="nowrap">{{ site.coverage.to }}</span></p>
    </div>
    {% set items_current = page_name.startswith("Items ") %}
    {% set more_current = page_name in ("About", "Changes", "Review (internal)") %}
    {# Wide screens: Officials plus two dropdowns. Phones: one Menu dropdown. Native <details>, no script; CSS shows
       one of the two navs. #}
    <nav aria-label="Main" class="nav-wide">
      <ul>
        <li><a href="{{ root }}index.html"{% if page_name == "Officials" %} aria-current="page"{% endif %}>Officials</a></li>
        <li class="nav-drop">
          <details class="menu" name="main-nav">
            <summary{% if items_current %} class="current"{% endif %}>Items</summary>
            <ul class="menu-list">
              {% for y in site.item_years_desc %}
              <li><a href="{{ root }}items/{{ y }}.html"{% if page_name == "Items " ~ y %} aria-current="page"{% endif %}>Items {{ y }}</a></li>
              {% endfor %}
            </ul>
          </details>
        </li>
        <li class="nav-drop">
          <details class="menu" name="main-nav">
            <summary{% if more_current %} class="current"{% endif %}>More</summary>
            <ul class="menu-list">
              <li><a href="{{ root }}about.html"{% if page_name == "About" %} aria-current="page"{% endif %}>About</a></li>
              <li><a href="{{ root }}changes.html"{% if page_name == "Changes" %} aria-current="page"{% endif %}>Changes</a></li>
              {% if site.internal %}
              <li><a href="{{ root }}review.html"{% if page_name == "Review (internal)" %} aria-current="page"{% endif %}>Review (internal)</a></li>
              {% endif %}
            </ul>
          </details>
        </li>
      </ul>
    </nav>
    <nav aria-label="Main (menu)" class="nav-narrow">
      <details class="menu">
        <summary>Menu</summary>
        <ul class="menu-list">
          <li><a href="{{ root }}index.html"{% if page_name == "Officials" %} aria-current="page"{% endif %}>Officials</a></li>
          {% for y in site.item_years_desc %}
          <li><a href="{{ root }}items/{{ y }}.html"{% if page_name == "Items " ~ y %} aria-current="page"{% endif %}>Items {{ y }}</a></li>
          {% endfor %}
          <li><a href="{{ root }}about.html"{% if page_name == "About" %} aria-current="page"{% endif %}>About</a></li>
          <li><a href="{{ root }}changes.html"{% if page_name == "Changes" %} aria-current="page"{% endif %}>Changes</a></li>
          {% if site.internal %}
          <li><a href="{{ root }}review.html"{% if page_name == "Review (internal)" %} aria-current="page"{% endif %}>Review (internal)</a></li>
          {% endif %}
        </ul>
      </details>
    </nav>
  </div>
</header>
<div class="rule-double" aria-hidden="true"></div>
<main id="main">
{% block main %}{% endblock %}
</main>
<footer class="site-footer">
  <p>Run by {{ site.operator }}. <a href="{{ root }}about.html">About this site and its data rules.</a></p>
  <p>Data as of {{ site.data_as_of }}</p>
</footer>
<script src="{{ root }}static/filter.js" defer></script>
{% block scripts %}{% endblock %}
</body>
</html>
