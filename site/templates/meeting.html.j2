{% extends "base.html.j2" %}
{% from "_meeting.html.j2" import meeting_stats, meeting_sections %}
{% from "_macros.html.j2" import watch_link %}
{% block main %}
<header class="meeting-head">
  <p class="kind-line"><span class="chip chip-kind">{{ kind_label }}</span></p>
  <h1>{{ kind_label }}, <span class="nowrap">{{ meeting.date | day_words }}</span></h1>
  <p class="source-line">{{ meeting.body }}. Source: <a href="{{ doc.url }}" target="_blank" rel="noopener noreferrer">{{ doc.kind }} PDF, {{ doc.pages }} pages<span class="sr-only"> (opens in a new tab)</span></a>, fetched {{ doc.fetched }}.</p>
{% if watch %}<p class="watch-line">{{ watch_link(watch) }}</p>{% endif %}
{{ meeting_stats(m) }}
</header>

{{ meeting_sections(m, root) }}
{% endblock %}
