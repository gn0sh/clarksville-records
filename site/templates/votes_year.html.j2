{% extends "base.html.j2" %}
{% from "_macros.html.j2" import source_cell, item_link, not_confirmed, nc_mark %}
{% block main %}
<h1>Votes, {{ year }}</h1>
<p class="lede">Every vote in {{ year }}, newest first. Each links to its meeting page, where every member's vote is shown.</p>
<nav class="year-nav" aria-label="Votes by year"><ul>
{% for y in years %}<li><a href="{{ y }}.html"{% if y == year %} aria-current="page"{% endif %}>{{ y }}</a></li>{% endfor %}
</ul></nav>
<ol class="vote-list" data-body="{{ site.cfg.county_key }}">{# every roll call here is the county's #}
{% for r in rows %}
  <li class="fact{% if not r.confirmed %} nc{% endif %}" data-fact-id="{{ r.id }}">
    <p class="tl-head"><a class="date" href="{{ root }}{{ r.meeting_href }}">{{ r.date | day_words }}</a> {{ item_link(r.item, root) }}{% if r.vote_on %} <span class="muted"><a href="{{ root }}about.html#vote-on">Vote on</a>: {{ r.vote_on }}.</span>{% endif %}</p>
    <p class="tl-sub">Outcome: <span class="chip chip-outcome">{{ r.outcome.label }}{% if not r.confirmed %}{{ nc_mark() }}{% endif %}</span>{% if r.outcome.tally %} ({{ r.outcome.tally }}){% endif %}{% if not r.confirmed %} {{ not_confirmed(r.src) }}{% endif %}</p>
    {# the source link stays visible; fetch date, fact id and "Report an error" sit behind Details (onceover/cite) #}
    <div class="meta vote-cite"><span class="cite-label">Source:</span> {{ source_cell(r.src, root, r.id) }}</div>
  </li>
{% else %}
  <li>No votes are recorded for {{ year }}.</li>
{% endfor %}
</ol>
{% endblock %}
