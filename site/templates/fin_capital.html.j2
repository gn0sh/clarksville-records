{% extends "base.html.j2" %}
{% from "_fin_macros.html.j2" import fin_cite, words_toggle %}
{% from "_budget_macros.html.j2" import group, flagged, jump %}
{% block main %}
{# Design finance-contracts 7, Note D. The capital fund's lines in book order, per book; no total across lines and no
   cost column. Without scripts the filter form stays hidden and every line shows. #}
<h1>{{ b.capital_title }}</h1>
<p class="coverage">{{ coverage_sentence }}</p>
<p class="note">{{ notes.d }}</p>
<p>{{ b.fund_page_link }} <a href="{{ fund_href }}">{{ b.fund_no }} {{ fund_no }}</a></p>
<form id="cap-filters" class="filters toolbar sol-filters" action="index.html" method="get" hidden>
  <div class="f-q">
    <label for="f-name">{{ b.filter_name }}</label>
    <input id="f-name" name="q" type="search">
  </div>
  <div>
    <label for="f-book">{{ b.filter_book }}</label>
    <select id="f-book" name="book"><option value="">Any</option>{% for bk in books %}<option value="{{ bk.id }}">{{ bk.title }}</option>{% endfor %}</select>
  </div>
  <div class="f-actions">
    <button type="button" id="f-clear">{{ c.clear_filters }}</button>
  </div>
</form>
<p id="cap-none" class="empty-note" hidden>{{ b.empty_filter }}</p>

{% for bk in books %}
<section class="fin-book" id="{{ bk.id }}" data-book="{{ bk.id }}" aria-labelledby="{{ bk.id }}-h">
<h2 id="{{ bk.id }}-h">{{ bk.title }}</h2>
{% if bk.absent %}
<p>{{ bk.absent_sentence }}</p>
{% else %}
<p class="sol-meta">{{ bk.source_line }} {{ fin_cite(bk.src) }}</p>
{{ jump(bk.groups, b) }}
{% for g in bk.groups %}{{ group(g, bk.caption, b, root, b.project_line) }}
{% endfor %}
{{ flagged(bk.flagged, b, root, b.project_line) }}
{% endif %}
</section>
{% endfor %}
{{ words_toggle(words, c, root) }}
{% if disclosure %}{% include "_disclosure.html.j2" %}{% endif %}
{% endblock %}
{% block scripts %}
<script src="{{ root }}static/finance.js" defer></script>
{% endblock %}
