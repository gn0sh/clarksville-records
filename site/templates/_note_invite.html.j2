{# The morning note's invitation (front-signup, 2026-11-18): one sentence and a link to the form on the Alerts page,
   not a second form. Shown only while the sign-up form is enabled (site.morning_note, sitegen/morning_page.py
   privacy()). The front page shows it under the address card; each body's landing page (county, city, planning
   commission) beside its header (wall of text, 2026-11-19: a first-time visitor may land there and never see the
   front page). Nothing is sent or counted here. #}
{% macro note_invite(mn, root) %}
{% if mn %}
<section class="note-invite" aria-label="{{ mn.heading }}">
  <p>{{ mn.front_pitch }}</p>
  <a class="note-invite-btn" href="{{ root }}{{ mn.signup_href }}">{{ mn.front_button }}</a>
</section>
{% endif %}
{% endmacro %}
