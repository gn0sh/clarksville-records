{% extends "base.html.j2" %}
{# `name` and `official` come from the directory entry (official re-checked against its platform's hosts; None
   when it fails, and then no link is printed). A covered government's coming-up page (docs/design/daylight-national.md section 5; architecture 3.5, 11). Built by
   sitegen/national_pages.py, which passes `meetings` made from the government's JSON only (meeting_view): item text
   is printed only from the JSON's `items`, and a withheld government's meetings print the fixed withheld label
   (privacy-withhold/national-prefix, consumer 3). Every fixed word is a page label (`L`); every other word is the
   feed's own text, and each verbatim feed string (time, a title that is not ours, item number and text) is the sole
   content of a bare <span data-feed> (architecture 12.1 row 6, B-ISO-8): qa/site_checks.py exempts that text, and only
   that text, from the checks that judge our own words. #}
{# the digest pages' own stylesheet (design 0a): linked here only, copied only while the switch is on #}
{% block head %}<link rel="stylesheet" href="{{ root }}static/digest.css">
{% endblock %}
{% block main %}
<div class="digest digest-body">
  <p class="eyebrow">{{ lt(L["body.eyebrow"], state=state_name, slot=slot) }}</p>
  <h1>{{ name }}</h1>
  <p class="digest-subject">{{ L["body.coming-up"] }}</p>
  {% if official %}<p class="official-record">{{ lh(L["body.official-record"], official, ext=true, host=host) }}</p>{% endif %}
  {# M1 records no check run, so the page says only how new our newest record is (national-freshness/
     checked-at-is-first-fetch); `newest` is the feed's checked_at day, None when we hold no record #}
  {% if newest %}
  <p class="digest-checked">{{ lt(L["body.newest"], date=(newest | day_words)) }}</p>
  {% else %}
  <p class="digest-checked">{{ L["body.no-records"] }}</p>
  {% endif %}
  {% for m in meetings %}
  <section class="digest-meeting" id="m-{{ m.id }}" aria-labelledby="m-{{ m.id }}-h">
    <h2 id="m-{{ m.id }}-h"><time datetime="{{ m.date }}">{{ m.day }}</time>{% if m.time %}, <span data-feed>{{ m.time }}</span>{% endif %}</h2>
    <p class="digest-meeting-title">{% if m.title_ours %}{{ m.title }}{% else %}<span data-feed>{{ m.title }}</span> {{ L["body.as-posted"] }}{% endif %}</p>
    <p class="digest-time">{% if m.time %}{{ lt(L["body.tz"], tz=m.tz) }}{% else %}{{ L["body.no-time"] }}{% endif %}</p>
    {% if m.posted %}
    <p class="digest-agenda">{{ lh(L["body.agenda"], m.agenda_url, ext=true, sr=lt(L["body.agenda-for"], date=(m.date | day_words))) }}</p>
    {% else %}
    <p class="digest-not-posted">{{ lh(L["body.not-posted"], official, ext=true) }}</p>
    {% endif %}
    {% if m.withheld %}
    <p class="digest-withheld">{{ lh(L["body.withheld"], m.agenda_url, ext=true) }}</p>
    {% elif m.incomplete %}
    <p class="digest-incomplete">{{ lh(L["body.incomplete"], m.agenda_url, ext=true) }}</p>
    {% endif %}
    {% if m.entries %}
    <ol class="digest-items">
      {% for it in m.entries %}
      <li>
        <h3>{% if it.number %}<span class="item-num"><span data-feed>{{ it.number }}</span></span> {% endif %}<span data-feed>{{ it.text }}</span></h3>
        {% if it.topics %}<p class="digest-topics">{% for t in it.topics %}<span class="chip digest-topic"><span class="sr-only">{{ L["body.topic-sr"] }} </span>{{ L[t] }}</span>{% if not loop.last %} {% endif %}{% endfor %}</p>{% endif %}
        {% if it.cut %}<p class="digest-cut">{{ lh(L["body.cut"], m.agenda_url, ext=true) }}</p>{% endif %}
        {% if it.page %}<p class="digest-item-src">{{ lh(L["body.item-page"], it.url, ext=true, page=it.page) }}</p>{% endif %}
      </li>
      {% endfor %}
    </ol>
    {% endif %}
  </section>
  {% else %}
  <p class="digest-none">{{ lh(L["body.no-meetings"], official, ext=true) }}</p>
  {% endfor %}
  {% if topic_note %}
  <p class="digest-topic-note">{{ lh(L["body.topic-note"], root ~ "about.html#item-types") }}</p>
  {% endif %}
  {% if full_href %}
  <p class="digest-full">{{ lh(L["body.full"], root ~ full_href) }}</p>
  {% endif %}
  {% if morning %}
  <p class="digest-morning">{{ lh(L["body.morning"], root ~ morning) }}</p>
  {% endif %}
</div>
{% endblock %}
