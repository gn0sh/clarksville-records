{# A body's hub cards (sitegen/bodies.py; config/site.yml `switch:`). A present card links a page this build makes; a
   coming card is dashed, says what is not collected yet and links the body's own official page (a URL from the
   config, never fetched). #}
{% from "_freshness.html.j2" import freshness as fresh with context %}
{% from "_macros.html.j2" import watch_link %}
{% macro coming_tag() %}<span class="chip chip-coming">Coming</span>{% endmacro %}
{% macro hub_kicker(hub) %}{% if hub and hub.kicker %}<p class="hub-kicker">{{ hub.kicker }}</p>{% endif %}{% endmacro %}
{# One header for every body's landing page (owner, 2026-11-14: "make it one header"): the county's hub, the City
   Council's home, the RPC's home and the school board's "coming" page. Always the same rows in the same order, a row
   only when the body has that fact: kicker, h1 (with the Coming tag when nothing is collected), a one-sentence lede,
   the coverage line (the caller's block: what is here and its dates, with the body's own counts), how recent the
   records are (_freshness.html.j2), the Watch link. The section cards follow it. Import `with context` (for `root`). #}
{% macro body_head(hub, title, lede, coming=false, freshness=none, freshness_note="", watch=none) %}
<div class="body-head"{% if hub %} data-body-head="{{ hub.key }}"{% endif %}>
{{ hub_kicker(hub) }}
<h1>{{ title }}{% if coming %} {{ coming_tag() }}{% endif %}</h1>
<p class="lede">{{ lede }}</p>
{% if caller is defined %}{% set cover = caller() | trim %}{% if cover %}<p class="body-cover">{{ cover }}</p>{% endif %}{% endif %}
{{ fresh(freshness or [], freshness_note) }}
{% if watch %}<p class="watch-line">{{ watch_link(watch) }}</p>{% endif %}
</div>
{% endmacro %}
{% macro hub_cards(hub, root, level=2) %}
{% if hub and hub.cards %}
<section class="hub" aria-labelledby="hub-h" data-hub="{{ hub.key }}">
  <h{{ level }} class="sec-h" id="hub-h">Sections</h{{ level }}>
  <ul class="hub-cards">
    {% for c in hub.cards %}
    <li class="hub-card{% if c.coming %} is-coming{% endif %}" data-card="{{ c.key }}" id="card-{{ c.key }}">
      <h{{ level + 1 }}>{{ c.title }}{% if c.coming %} {{ coming_tag() }}{% endif %}</h{{ level + 1 }}>
      <p>{{ c.text }}</p>
      {% if c.coming %}
      {% if c.link %}<p class="hub-go">Official source: <a data-ext="{{ c.link.kind }}" href="{{ c.link.url }}" target="_blank" rel="noopener noreferrer">{{ c.link.label }}<span class="sr-only"> (opens in a new tab)</span></a></p>{% endif %}
      {% else %}
      <p class="hub-go"><a href="{{ root }}{{ c.href }}"><span>{{ c.go }}</span><span class="sr-only">, {{ hub.label }}</span><span class="go" aria-hidden="true">&rsaquo;</span></a></p>
      {% endif %}
    </li>
    {% endfor %}
  </ul>
  {% if hub.note %}<p class="note hub-note">{{ hub.note }}</p>{% endif %}
</section>
{% endif %}
{% endmacro %}
{# The home page's overview: every body, what is on this site and what is coming. With `overview.fold` set, the cards
   sit in a <details> that is built open: wide screens hide its summary (style.css), so nothing can close it; on a
   phone static/landing.js closes it when the page loads, so the list is one line until asked for (without the script
   it stays open). The "Coming" notes stay in the page either way. #}
{% macro overview(sw, root) %}
{% if sw and sw.hubs %}
<section class="bodies" aria-labelledby="bodies-h">
  <h2 class="sec-h" id="bodies-h">{{ sw.overview.heading }}</h2>
  {% if sw.overview.fold %}<details class="bodies-fold" id="bodies-fold" open>
  <summary>{{ sw.overview.fold }}</summary>{% endif %}
  <p class="sec-sub">{{ sw.overview.lede }}</p>
  <ul class="bodies-list">
    {% for o in sw.options if o.key != "all" %}{% set h = sw.hubs[o.key] %}
    <li class="bodies-card" data-hub="{{ h.key }}">
      <h3><a href="{{ root }}{{ h.href }}">{{ h.label }}</a>{% if o.coming %} {{ coming_tag() }}{% endif %}</h3>
      {% if h.about %}<p>{{ h.about }}</p>{% endif %}
      {% if h.present %}<p><span class="bodies-k">{{ sw.overview.present }}</span> {{ h.present | join(", ") }}.</p>{% endif %}
      {% if h.coming %}<p class="bodies-coming"><span class="bodies-k">{{ sw.overview.coming }}</span> {{ h.coming | join(", ") }}.</p>{% endif %}
    </li>
    {% endfor %}
  </ul>
  {% if sw.overview.fold %}</details>{% endif %}
</section>
{% endif %}
{% endmacro %}
