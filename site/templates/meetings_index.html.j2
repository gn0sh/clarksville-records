{% extends "base.html.j2" %}
{% from "_macros.html.j2" import watch_link %}
{% block main %}
<h1>Meetings</h1>
<p class="lede">{{ coverage.body }}, {{ coverage.from }} to {{ coverage.to }}. Newest first. Each meeting page shows attendance, motions and roll calls.</p>
{% if watch %}<p class="watch-line">{{ watch_link(watch) }}</p>{% endif %}
{# every row here is the county's: static/switch.js hides the lists when another body is chosen #}
<div data-body="{{ site.cfg.county_key }}">
{% if agenda_only %}
<section aria-labelledby="agenda-only-h">
<h2 id="agenda-only-h">Agendas without minutes yet</h2>
<p>{{ agenda_list_lede }} <a href="{{ agendas_href }}">All agenda items</a>.</p>
<ol class="timeline meetings" aria-label="Meetings with an agenda and no minutes yet">
  {% for m in agenda_only %}
  <li class="ev-meeting">
    <p class="tl-head"><a class="date" href="{{ m.href }}">{{ m.date }}</a> <span class="tl-kind">{{ m.kind_label }}</span></p>
    <p class="tl-sub">Agenda: {{ m.n_items }} {{ "item" if m.n_items == 1 else "items" }}{% if m.note %} <span class="sep" aria-hidden="true">&middot;</span> {{ m.note }}{% endif %}</p>
  </li>
  {% endfor %}
</ol>
</section>
{% endif %}
{% if meetings_by_year %}
<details class="menu year-jump">
  <summary>Jump to year</summary>
  <ul class="menu-list" aria-label="Meeting years">
  {% for g in meetings_by_year %}
    <li><a href="#y{{ g.year }}">{{ g.year }}</a></li>
  {% endfor %}
  </ul>
</details>
{% for g in meetings_by_year %}
<details class="year-group"{% if loop.first %} open{% endif %}>
<summary><span class="year-label">{{ g.year }}</span></summary>
<ol class="timeline meetings" id="y{{ g.year }}" aria-label="Meetings in {{ g.year }}">
  {% for m in g.meetings %}
  <li class="ev-meeting">
    <p class="tl-head"><a class="date" href="{{ m.href }}">{{ m.date }}</a> <span class="tl-kind">{{ m.kind_label }}</span></p>
    <p class="tl-sub">{{ m.rc_confirmed + m.rc_unconfirmed }} roll {{ "call" if m.rc_confirmed + m.rc_unconfirmed == 1 else "calls" }} ({{ m.rc_unconfirmed }} not confirmed*) <span class="sep" aria-hidden="true">&middot;</span> {{ m.motions }} {{ "motion" if m.motions == 1 else "motions" }} <span class="sep" aria-hidden="true">&middot;</span> {% if m.att_state == "shown" %}{{ m.present }} of {{ m.listed }} members present{% else %}attendance not shown{% endif %}</p>
  </li>
  {% endfor %}
</ol>
</details>
{% endfor %}
{% else %}
<p>No meetings are available yet.</p>
{% endif %}
</div>
{% endblock %}
