{% extends "base.html.j2" %}
{% from "_city_committee.html.j2" import cm_docs, cm_motion, cm_attendance %}
{# A city committee's meetings in one year (sitegen/committees.py meetings_year), oldest first. One section per
   meeting (#<meeting id>): its documents, the attendance and the motions as the minutes print them. #}
{% block main %}
<p class="kicker-line"><a href="{{ root }}{{ home_href }}">{{ kicker }} {{ body }}</a></p>
<h1>Meetings in {{ year }}</h1>
<p class="lede">{{ kicker }} {{ body }}. Each meeting shows its documents and, where the minutes are posted, the attendance and motions as printed, each with a link to its page of the minutes.</p>
<nav aria-label="Meetings by year" class="year-nav">
  <ul class="inline-list">
    {% for y in years %}<li><a href="{{ y }}.html"{% if y == year %} aria-current="page"{% endif %}>{{ y }}</a></li>{% endfor %}
  </ul>
</nav>
<details class="toc-group" open>
  <summary>{{ meetings | length }} {{ "meeting" if meetings | length == 1 else "meetings" }} in {{ year }}</summary>
  <ul class="toc">
    {% for m in meetings %}
    <li><a href="#{{ m.id }}">{{ m.date | day_words }}</a></li>
    {% endfor %}
  </ul>
</details>

{% for m in meetings %}
<section class="council-meeting" id="{{ m.id }}" aria-labelledby="h-{{ m.id }}">
  <header class="meeting-head">
    <p class="kind-line"><span class="chip chip-kind">{{ body }}</span>{% if m.cancelled %} <span class="chip chip-status">Cancelled</span>{% endif %}{% if m.upcoming %} <span class="chip chip-status">Upcoming</span>{% endif %}</p>
    <h2 id="h-{{ m.id }}">{{ body }}, <span class="nowrap">{{ m.date_text }}</span></h2>
    <p class="muted">Listed as: {{ m.printed }}.</p>
  </header>
  {{ cm_docs(m) }}
  {% if m.upcoming %}
  <p class="muted">An upcoming meeting: its minutes are posted after it is held.</p>
  {% elif "Minutes" in m.not_posted %}
  <p class="muted">Minutes not posted on the city's portal{% if "Agenda" not in m.not_posted %}; the agenda is linked above{% endif %}.</p>
  {% elif m.other_date %}
  <p class="muted">The minutes listed for this meeting print the date {{ m.other_date }}. They are linked as the city lists them; nothing read from them is shown here.</p>
  {% elif m.minutes_unread %}
  <p class="muted">The minutes were not read here (no text layer, or not collected yet); the PDF is the record.</p>
  {% endif %}
  {{ cm_attendance(m) }}
  {% if m.motions %}
  <h3 id="{{ m.id }}-motions">Motions in the minutes ({{ m.motions | length }})</h3>
  <p class="muted">{% if motions_held %}Each motion's item and words as printed and its page of the minutes. Votes are not shown while they are checked against the minutes.{% else %}As printed. A voice vote is shown as "Voice vote (not recorded by name)" with its outcome; members are named on a vote only where the minutes print their names.{% endif %}</p>
  {% for mv in m.motions %}{{ cm_motion(mv) }}{% endfor %}
  {% endif %}
</section>
{% endfor %}
{% endblock %}
