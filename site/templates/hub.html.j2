{% extends "base.html.j2" %}
{% from "_hub.html.j2" import hub_cards, body_head with context %}
{# A body's hub page when the body has no home page of its own (sitegen/bodies.py): the county's. #}
{% block main %}
{% call body_head(hub, hub.title, hub.lede, freshness=freshness | default([]), freshness_note=freshness_note | default(""), watch=watch | default(none)) %}
{% if cover is defined and cover %}{{ cover.what[:1] | upper }}{{ cover.what[1:] }}, <span class="nowrap">{{ cover.from }}</span> to <span class="nowrap">{{ cover.to }}</span>.{% endif %}
{% endcall %}
{{ hub_cards(hub, root) }}
{% endblock %}
