{% extends "base.html.j2" %}
{% from "_macros.html.j2" import fact_meta %}
{% from "_fin_macros.html.j2" import fin_cites, words_toggle %}
{% block main %}
<div class="fin">
{# Design finance-contracts 6: books, then funds in the book's order. The figure blocks are the county property tax dollar
   (owner 2026-11-18, architecture finance-contracts 12) and the general fund dollar (owner's request 2026-11-11,
   architecture finance-contracts 11): no other amount, chart or total tile. #}
<h1>{{ b.title }}</h1>
{# Which body's money this is, first (owner 2026-11-12). The links are the bodies' own sites, from the config. #}
{% if body_note is defined and body_note %}<p class="note body-note" id="body-note"><strong>{{ body_note.text }}</strong>{% if body_note.sibling %} {{ body_note.sibling.lede }} <a href="{{ root }}{{ body_note.sibling.href }}">{{ body_note.sibling.label }}</a>.{% endif %}{% if body_note.links %} {{ body_note.link_lede }}{% for l in body_note.links %} <a data-ext="{{ l.kind }}" href="{{ l.url }}" target="_blank" rel="noopener noreferrer">{{ l.label }}<span class="sr-only"> (opens in a new tab)</span></a>{{ "." if loop.last else "," }}{% endfor %}{% endif %}</p>{% endif %}
<p class="coverage">{{ coverage_sentence }}</p>
<p class="note">{{ notes.e }}</p>
{% if not_covered %}<p class="note" id="not-covered">{{ not_covered.text }} <a data-ext="{{ not_covered.link.kind }}" href="{{ not_covered.link.url }}" target="_blank" rel="noopener noreferrer">{{ not_covered.link.label }}<span class="sr-only"> (opens in a new tab)</span></a>.</p>{% endif %}

<div data-body="{{ body_key | default(site.cfg.county_key) }}">{# every book and fund here is one body's (the county's, or the city's under city/) #}
{% if proptax is defined and proptax %}{% include "_proptax.html.j2" %}{% endif %}
{# the city budget dollar, by fund (CEO 2026-11-18, architecture city-funds-dollar): the city's page only #}
{% if fundsplit is defined and fundsplit %}{% include "_funds.html.j2" %}{% endif %}
{% if dollar is defined and dollar %}{% include "_dollar.html.j2" %}{% endif %}
<section aria-labelledby="books-h">
<h2 id="books-h">{{ b.books_heading }}</h2>
<ul class="fin-books">
{% for bk in books %}
  <li><a href="{{ bk.url }}" target="_blank" rel="noopener noreferrer">{{ bk.title }}<span class="sr-only"> (opens the budget book PDF in a new tab)</span></a> <span class="muted">FY{{ bk.fiscal_year }}, {{ bk.edition }}, fetched {{ bk.fetched }}</span>{% for d in bk.report_dates %}{% if loop.first %} <span class="muted">Report date as printed: {% endif %}{{ d.text }} <a href="{{ d.src.url }}" target="_blank" rel="noopener noreferrer">p. {{ d.src.page }}<span class="sr-only"> (opens the budget book PDF in a new tab)</span></a>{% if loop.last %}</span>{% else %}, {% endif %}{% endfor %}</li>
{% endfor %}
{% for n in not_read | default([]) %}
  <li><a href="{{ n.url }}" data-ext="record" target="_blank" rel="noopener noreferrer">{{ n.title }}<span class="sr-only"> (opens the budget book PDF in a new tab)</span></a> <span class="muted">FY{{ n.fiscal_year }}</span> {{ n.sentence }}</li>
{% endfor %}
</ul>
{% for m in missing %}<p class="note">{{ m }}</p>
{% endfor %}
</section>

<section aria-labelledby="funds-h">
<h2 id="funds-h"><a href="{{ root }}glossary.html#fund">{{ b.funds_heading }}</a></h2>
<div class="table-scroll fin-scroll">
<table class="fin-stack fin-funds">
  <caption class="sr-only">{{ b.funds_heading }}</caption>
  <thead>
    <tr>{% if numbered %}<th scope="col">{{ b.fund_no }}</th>{% endif %}<th scope="col">{{ b.fund_name }}</th><th scope="col">{{ b.source }}</th></tr>
  </thead>
  <tbody>
  {% for f in funds %}
    <tr class="fact" data-fact-id="{{ f.fact_id }}">
      {%+ if numbered %}<td class="c-fundno" data-label="{{ b.fund_no }}">{{ f.no }}</td>{% endif +%}
      <th scope="row" class="c-fundname" data-label="{{ b.fund_name }}"><a href="{{ root }}{{ f.href }}">{{ f.names[0].name }}</a>{% for n in f.names[1:] if n.name != f.names[0].name %}<br><small>{{ n.book }}: {{ n.name }}</small>{% endfor %}</th>
      <td class="c-source cite" data-label="{{ b.source }}">{{ fin_cites(f.names | map(attribute="src") | list, root, f.fact_id) }}</td>
    </tr>
  {% endfor %}
  </tbody>
</table>
</div>
{% if capital_href %}<p><a href="{{ root }}{{ capital_href }}">{{ b.capital_title }}</a></p>{% endif %}
</section>
</div>
{% if exports %}<p class="exports">Download: <a href="{{ root }}data/budget_lines.csv">Budget lines (CSV)</a> <span class="sep" aria-hidden="true">&middot;</span> <a href="{{ root }}data/budget_checks.csv">Total checks (CSV)</a> <span class="sep" aria-hidden="true">&middot;</span> <a href="{{ root }}data/finance.json">JSON</a></p>{% endif %}
{{ words_toggle(words, c, root) }}
{% if disclosure %}{% include "_disclosure.html.j2" %}{% endif %}
</div>
{% endblock %}
