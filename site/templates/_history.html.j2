{% from "_macros.html.j2" import source, source_cell, clamp, fact_meta, item_link, not_confirmed, outcome_not_confirmed, nc_mark, chip, motion_by %}
{# The history table, one per year in a <details> (newest open). Used by official pages and seat pages. #}
{% macro history_groups(row_groups, root, empty="No votes, attendance, motions or seconds are shown for this person in this period.", open_all=False) %}
  {% for g in row_groups %}
  <details class="year-group" data-year="{{ g.year }}"{% if g.year and open_all %} id="year-{{ g.year }}"{% endif %}{% if loop.first or open_all %} open{% endif %}>
  <summary><span class="year-label">{{ g.year or "No rows" }}</span> <span class="muted">({{ g.rows|length }} {{ "row" if g.rows|length == 1 else "rows" }})</span></summary>
  <div class="table-scroll" tabindex="0" role="region" aria-label="History table, {{ g.year }}">
  <table class="history stack" role="table">
    <colgroup><col class="c-date"><col class="c-type"><col class="c-item"><col class="c-record"><col class="c-outcome"><col class="c-source"></colgroup>
    <thead role="rowgroup">
      <tr role="row">
        <th scope="col" role="columnheader">Date</th>
        <th scope="col" role="columnheader">Type</th>
        <th scope="col" role="columnheader">Item</th>
        <th scope="col" role="columnheader">Record</th>
        <th scope="col" role="columnheader">Outcome</th>
        <th scope="col" role="columnheader">Source</th>
      </tr>
    </thead>
    <tbody role="rowgroup">
    {% for r in g.rows %}
      <tr role="row" class="fact{% if not r.confirmed %} nc{% endif %}" data-type="{{ r.type }}" data-year="{{ r.year }}" data-fact-id="{{ r.fact_id }}">
        <td role="cell" class="c-date" data-label="Date"><div><a class="date" href="{{ root }}{{ r.meeting_href }}">{{ r.date }}</a></div></td>
        <td role="cell" class="c-type" data-label="Type"><div><span class="chip chip-type">{{ r.type_label }}</span></div></td>
        <td role="cell" class="c-item" data-label="Item"><div>
          {% if r.item %}{% call clamp(2) %}{{ item_link(r.item, root) }}{% endcall %}{% else %}<a href="{{ root }}{{ r.meeting_href }}">{{ r.meeting_label }}</a>{% endif %}
          {% if r.vote_on %}<br><small class="vote-on"><a href="{{ root }}about.html#vote-on">Vote on</a>: {{ r.vote_on }}.</small>{% endif %}
          {% if r.motion_label %}<br><small>{{ r.motion_label }}. {% if r.motion_by %}{{ motion_by(r.motion_by, root) }}.{% else %}Attribution under review.{% endif %}</small>{% endif %}
        </div></td>
        <td role="cell" class="c-record" data-label="Record"><div>{% if r.key %}{{ chip(r.record, r.key, not r.confirmed) }}{% else %}{{ r.record }}{% if not r.confirmed %}{{ nc_mark() }}{% endif %}{% endif %}</div></td>
        <td role="cell" class="c-outcome" data-label="Outcome"><div>{% if r.outcome and not r.outcome.hidden %}<span class="chip chip-outcome">{{ r.outcome.label }}{% if not r.outcome.confirmed %}{{ nc_mark() }}{% endif %}</span>{% if r.outcome.tally %}<br><small>{{ r.outcome.tally }}</small>{% endif %}{% elif r.outcome %}<span class="muted" aria-hidden="true">&ndash;</span><span class="sr-only">Not shown (see Details)</span>{% else %}<span class="muted">Not shown</span>{% endif %}</div></td>
        <td role="cell" class="c-source cite" data-label="Source"><div>{% set note %}{% if not r.confirmed %}<p>{{ not_confirmed(r.src) }}</p>{% elif r.outcome and not r.outcome.confirmed %}<p>{{ outcome_not_confirmed(r.outcome.src) }}</p>{% endif %}{% endset %}{{ source_cell(r.src, root, r.fact_id, note) }}</div></td>
      </tr>
    {% else %}
      <tr role="row" class="empty"><td role="cell" colspan="6">{{ empty }}</td></tr>
    {% endfor %}
    </tbody>
  </table>
  </div>
  </details>
  {% endfor %}
{% endmacro %}
